# Bright Data API key. This exact variable name is what the CLI and Airlock both read.
# (Some Bright Data docs show BRIGHT_DATA_API_TOKEN — that is not the name in use here.)
BRIGHTDATA_API_KEY=your_key_here

# Optional override. Defaults to the airlock-books collector in example-output/create.json.
# AIRLOCK_COLLECTOR_ID=c_msxm9dky3p0ydhbm3
